{
  "name": "opencode-peer-mcp",
  "version": "0.1.0",
  "description": "MCP server bridging OpenCode sessions across configured servers",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opencode-peer-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "bun check && bun check -p tsconfig.tests.json",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "OPENCODE_PEER_MCP_SKIP_FIXTURES=1 bun test tests/*.test.ts",
    "dev": "bun --hot src/index.ts",
    "start": "node dist/index.js",
    "test:integration": "bun run build && bun test tests/integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^22.10.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
