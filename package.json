{
  "name": "opencode-peer-mcp",
  "version": "0.1.0",
  "description": "MCP server bridging OpenCode sessions across configured servers",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opencode-peer-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "OPENCODE_PEER_MCP_SKIP_FIXTURES=1 bun test tests/*.test.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test:integration": "bun run build && bun test tests/integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.4.5",
    "@types/node": "^22.10.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.0.0"
  }
}
