{
  "name": "opencode-peer-mcp",
  "version": "0.1.0",
  "description": "MCP server bridging OpenCode sessions across configured servers",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacklaw1410/opencode-peer-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "opencode-peer-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "bun check && bun check -p tsconfig.tests.json",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "bun test tests/*.test.ts",
    "dev": "bun --hot src/index.ts",
    "start": "node dist/index.js",
    "test:integration": "bun run build && bun test --path-ignore-patterns \"\" --preload ./tests/integration/preload.ts tests/integration",
    "evals": "bun run build && playwright test --config tests/evals/playwright.config.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.46",
    "@ai-sdk/deepseek": "^2.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.31",
    "@gleanwork/mcp-server-tester": "^1.1.1",
    "@playwright/test": "^1.65.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/bun": "^1.4.5",
    "@types/node": "^22.10.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ai": "^6.0.0",
    "openai": "^7.62.0",
    "semantic-release": "^26.0.1"
  }
}
